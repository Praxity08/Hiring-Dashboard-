# Neon connection string (Neon console > Connect, or the Vercel Neon integration sets it for you)
DATABASE_URL=
# Gemini API key from aistudio.google.com (free tier works)
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.8-flash)
GEMINI_MODEL=
# Password the founder types to open the dashboard
APP_PASSWORD=

# Resend (email sending). EMAIL_FROM must use a domain you've verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Arjun Mehta <hiring@yourdomain.com>
# Optional: where candidate replies go
EMAIL_REPLY_TO=
# Optional safety net: while set, every email goes here instead of the candidate
EMAIL_TEST_TO=
